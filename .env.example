# Every setting in src/rag_kb/config.py, with its default. Only EMBEDDING_API_KEY is required.

# Embeddings: any OpenAI-compatible /v1/embeddings endpoint. The model and its threshold belong together
# (MIN_SIMILARITY below); another model also needs a migration if its dimension is not 1024.
EMBEDDING_BASE_URL=https://models-interview.arvancloudai.ir/v1
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=Bge-m3

# Language model: compose.yaml runs Ollama with gemma4:e4b-it-qat. For `make dev`, or another provider,
# any OpenAI-compatible chat endpoint works (ArvanCloud AIaaS, vLLM, OpenAI, ...).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=gemma4:e4b-it-qat
# Thinking models (Gemma 4) reason before answering: none | low | medium | high. compose.yaml sets none;
# leave it unset for models without a reasoning setting, which reject it.
LLM_REASONING_EFFORT=none

# Cosine similarity the best chunk must reach; below it the question is refused without calling the
# LLM. Calibrated for Bge-m3 (docs/decisions.md, decision 6); recalibrate with eval/ for another model.
# MIN_SIMILARITY=0.58

# Also search with the question translated into the other language (Persian ↔ English) by the LLM:
# +3 answered of 68 in the evaluation (decision 10), at one extra short LLM call per question.
# QUERY_TRANSLATION=true

# Largest accepted upload, in bytes (20 MB).
# MAX_UPLOAD_BYTES=20971520

# Database for `make dev` (compose.yaml sets its own for the api container). If port 5432 is taken by
# another Postgres, set both:
# DB_PORT=5433
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
